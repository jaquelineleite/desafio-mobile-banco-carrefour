{
  "name": "qa-mobile-automation-webdriverio-appium",
  "version": "1.0.0",
  "description": "Framework de automação mobile com WebdriverIO, Appium e TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:android",
    "test:launch": "wdio run ./config/wdio.android.conf.ts --spec ./test/specs/app-launch.spec.ts",
    "test:login": "wdio run ./config/wdio.android.conf.ts --spec ./test/specs/login.spec.ts",
    "test:signup": "wdio run ./config/wdio.android.conf.ts --spec ./test/specs/signup.spec.ts",
    "test:forms": "wdio run ./config/wdio.android.conf.ts --spec ./test/specs/forms.spec.ts",
    "test:swipe": "wdio run ./config/wdio.android.conf.ts --spec ./test/specs/swipe.spec.ts",
    "test:drag": "wdio run ./config/wdio.android.conf.ts --spec ./test/specs/drag.spec.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npm run allure:generate && npm run allure:open",
    "typecheck": "tsc --noEmit",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:browserstack:android": "wdio run ./config/wdio.browserstack.android.conf.ts",
    "test:browserstack:ios": "wdio run ./config/wdio.browserstack.ios.conf.ts"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "mobile",
    "automation",
    "typescript"
  ],
  "author": "Jaqueline Fernandes de Andrade",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^26.1.1",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/browserstack-service": "^9.33.2",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "appium-uiautomator2-driver": "^8.1.2",
    "chai": "^6.2.2",
    "expect-webdriverio": "^5.7.0",
    "typescript": "^7.0.2"
  }
}
